@page "/MeetingEndConfirmation/{MeetingGuidString}"
@implements IDisposable

@using Microsoft.Extensions.Logging
@using TrackYourDay.Core.ApplicationTrackers.Jira
@using TrackYourDay.Core.ApplicationTrackers.MsTeams
@using TrackYourDay.Core.MAUIProxy
@using MediatR

@inject IMediator mediator
@inject MsTeamsMeetingTracker meetingService
@inject NavigationManager navigationManager
@inject IJiraRestApiClient jiraRestApiClient
@inject IJiraSettingsService jiraSettingsService
@inject ILogger<MeetingEndConfirmation> logger

@if (!string.IsNullOrEmpty(meetingTitle))
{
    <div class="meeting-container">
        <!-- Header with status indicator -->
        <div class="meeting-header">
            <h3 class="meeting-header-title">Did this meeting end?</h3>
        </div>

        <!-- Scrollable content area -->
        <div class="meeting-content">
            <!-- Meeting Information -->
            <div class="meeting-info">
                <div class="meeting-info-row">
                    <span class="meeting-info-label">Meeting:</span>
                    <span class="meeting-info-value">@meetingTitle</span>
                </div>
                <div class="meeting-info-row">
                    <span class="meeting-info-label">Started:</span>
                    <span class="meeting-info-value">@(startTime != DateTime.MinValue ? startTime.ToString("HH:mm") : "Unknown")</span>
                </div>
            </div>

            <!-- Start Time Selection -->
            <MudTimePicker Time="@customStartTime"
                           TimeChanged="OnStartTimeChanged"
                           Label="Meeting Start Time"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Editable="true"
                           AmPm="false"
                           TimeFormat="HH:mm"
                           TimeEditFormat="HH:mm"
                           PickerVariant="PickerVariant.Dialog"
                           Required="true"
                           aria-label="Select meeting start time" />

            <div class="time-adjustment-group">
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           OnClick="@(() => SubtractStartMinutes(5))"
                           StartIcon="@Icons.Material.Filled.Remove"
                           aria-label="Subtract 5 minutes from start">
                    5m
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           OnClick="@(() => SubtractStartMinutes(10))"
                           StartIcon="@Icons.Material.Filled.Remove"
                           aria-label="Subtract 10 minutes from start">
                    10m
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           OnClick="@(() => SubtractStartMinutes(15))"
                           StartIcon="@Icons.Material.Filled.Remove"
                           aria-label="Subtract 15 minutes from start">
                    15m
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           OnClick="@(() => AddStartMinutes(5))"
                           StartIcon="@Icons.Material.Filled.Add"
                           aria-label="Add 5 minutes to start">
                    5m
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           Color="Color.Primary"
                           OnClick="ResetStartToOriginal"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           aria-label="Reset start to original">
                    Reset
                </MudButton>
            </div>

            <div class="meeting-info">
                @if (startTime != DateTime.MinValue && endTime.HasValue)
                {
                    var effectiveStart = customStartTime.HasValue ? DateTime.Today.Add(customStartTime.Value) : startTime;
                    var duration = DateTime.Today.Add(endTime.Value) - effectiveStart;
                    if (duration.TotalSeconds < 0) 
                    {
                        duration = duration.Add(TimeSpan.FromDays(1));
                    }
                    <div class="meeting-info-row">
                        <span class="meeting-info-label">Duration:</span>
                        <span class="meeting-info-value">@($"{(int)duration.TotalHours}h {duration.Minutes}m")</span>
                    </div>
                }
            </div>

            <!-- End Time Selection -->
            <MudTimePicker Time="@endTime"
                           TimeChanged="OnTimeChanged"
                           Label="Meeting End Time"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Editable="true"
                           AmPm="false"
                           TimeFormat="HH:mm"
                           TimeEditFormat="HH:mm"
                           PickerVariant="PickerVariant.Dialog"
                           Required="true"
                           Error="@(!endTime.HasValue && showValidation)"
                           ErrorText="@(showValidation && !endTime.HasValue ? "End time is required" : string.Empty)"
                           aria-label="Select meeting end time" />

            <div class="time-adjustment-group">
                <MudButton Variant="Variant.Text" 
                           Size="Size.Small" 
                           OnClick="@(() => SubtractMinutes(5))"
                           StartIcon="@Icons.Material.Filled.Remove"
                           aria-label="Subtract 5 minutes">
                    5m
                </MudButton>
                <MudButton Variant="Variant.Text" 
                           Size="Size.Small" 
                           OnClick="@(() => SubtractMinutes(10))"
                           StartIcon="@Icons.Material.Filled.Remove"
                           aria-label="Subtract 10 minutes">
                    10m
                </MudButton>
                <MudButton Variant="Variant.Text" 
                           Size="Size.Small" 
                           OnClick="@(() => SubtractMinutes(15))"
                           StartIcon="@Icons.Material.Filled.Remove"
                           aria-label="Subtract 15 minutes">
                    15m
                </MudButton>
                <MudButton Variant="Variant.Text" 
                           Size="Size.Small" 
                           Color="Color.Primary"
                           OnClick="ResetToCurrentTime"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           aria-label="Reset to current time">
                    Now
                </MudButton>
            </div>

            <MudTextField @bind-Value="customDescription"
                          Label="Worklog Comment (required)"
                          Placeholder="Describe what was done in this meeting"
                          Variant="Variant.Outlined"
                          Lines="2"
                          Margin="Margin.Dense"
                          Class="mt-3"
                          Error="@(showValidation && string.IsNullOrWhiteSpace(customDescription))"
                          ErrorText="@(showValidation && string.IsNullOrWhiteSpace(customDescription) ? "Comment is required" : string.Empty)"
                          aria-label="Meeting description" />

            <MudPaper Outlined="true" Class="pa-3 mt-2">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Log time to Jira</MudText>

                @if (isLoadingJiraIssues)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
                }
                else if (!string.IsNullOrWhiteSpace(jiraIssuesLoadingError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@jiraIssuesLoadingError</MudAlert>
                }
                else
                {
                    <MudSelect T="string"
                               @bind-Value="selectedJiraIssueKey"
                               Label="Jira Issue"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Required="true"
                               Error="@(showValidation && string.IsNullOrWhiteSpace(selectedJiraIssueKey))"
                               ErrorText="@(showValidation && string.IsNullOrWhiteSpace(selectedJiraIssueKey) ? "Jira issue is required" : string.Empty)">
                        @foreach (var issue in jiraIssues)
                        {
                            <MudSelectItem Value="@issue.Key">@($"{issue.Key} - {issue.Summary}")</MudSelectItem>
                        }
                    </MudSelect>
                    @if (!jiraIssues.Any())
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">No Jira issues found for configured query.</MudAlert>
                    }
                }
            </MudPaper>

            <MudButton Variant="Variant.Filled" 
                       Color="Color.Success" 
                       FullWidth="true" 
                       OnClick="ConfirmEnd"
                       Disabled="@(!CanConfirm)"
                       StartIcon="@Icons.Material.Filled.CheckCircle"
                       Class="mt-3"
                       aria-label="Confirm meeting ended and log time">
                @if (isProcessing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
                else
                {
                    <span>Confirm Meeting and Log Time</span>
                }
            </MudButton>

            <MudButton Variant="Variant.Filled" 
                       Color="Color.Error" 
                       FullWidth="true" 
                       OnClick="CancelMeeting"
                       Disabled="@(isProcessing || localMeetingConfirmed)"
                       StartIcon="@Icons.Material.Filled.Cancel"
                       Class="mt-2"
                       aria-label="This was not a meeting">
                @if (isProcessing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
                else
                {
                    <span>This was not a meeting</span>
                }
            </MudButton>

            <!-- Postpone Section -->
            <div class="mt-3">
                <div class="postpone-header">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Class="mr-1" />
                        Postpone Check
                    </MudText>
                </div>

                <MudStack Spacing="1" Class="mt-2">
                    <MudStack Row="true" Spacing="1" Justify="Justify.Center">
                        <MudButton Variant="Variant.Outlined" 
                                   Size="Size.Small" 
                                   Color="Color.Info"
                                   OnClick="@(() => Postpone(5))"
                                   Disabled="isProcessing"
                                   StartIcon="@Icons.Material.Filled.Schedule">
                            +5m
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" 
                                   Size="Size.Small" 
                                   Color="Color.Info"
                                   OnClick="@(() => Postpone(10))"
                                   Disabled="isProcessing"
                                   StartIcon="@Icons.Material.Filled.Schedule">
                            +10m
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" 
                                   Size="Size.Small" 
                                   Color="Color.Info"
                                   OnClick="@(() => Postpone(15))"
                                   Disabled="isProcessing"
                                   StartIcon="@Icons.Material.Filled.Schedule">
                            +15m
                        </MudButton>
                    </MudStack>

                    <MudTimePicker Time="@postponeTime"
                                   TimeChanged="OnPostponeTimeChanged"
                                   Label="Custom Postpone Time"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Editable="true"
                                   AmPm="false"
                                   TimeFormat="HH:mm"
                                   TimeEditFormat="HH:mm"
                                   PickerVariant="PickerVariant.Dialog"
                                   aria-label="Select custom postpone time" />
                </MudStack>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@errorMessage</MudAlert>
            }

            @if (localMeetingConfirmed)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           FullWidth="true"
                           OnClick="CloseWindow"
                           Class="mt-2"
                           StartIcon="@Icons.Material.Filled.Close">
                    Close
                </MudButton>
            }
        </div>

        <!-- Fixed action footer -->
        <div class="action-footer">
            <MudButton Variant="Variant.Outlined" 
                       FullWidth="true" 
                       OnClick="StillOngoing"
                       Disabled="@(isProcessing || localMeetingConfirmed)"
                       StartIcon="@Icons.Material.Filled.AccessTime"
                       aria-label="Meeting still ongoing">
                @if (postponeTime.HasValue)
                {
                    <span>Still Ongoing - Postpone Until @postponeTime.Value.ToString(@"hh\:mm")</span>
                }
                else
                {
                    <span>Still Ongoing</span>
                }
            </MudButton>
        </div>
    </div>
}
else
{
    <div style="padding: 16px;">
        <MudAlert Severity="Severity.Warning">Meeting confirmation expired or already handled</MudAlert>
    </div>
}

@code {
    [Parameter]
    public string MeetingGuidString { get; set; } = string.Empty;

    [CascadingParameter(Name = "ParentMauiWindowId")]
    public Guid ParentMauiWindowId { get; set; }

    private Guid meetingGuid;
    private string? meetingTitle;
    private DateTime startTime = DateTime.MinValue;
    private TimeSpan? endTime;
    private TimeSpan? customStartTime;
    private string? customDescription;
    private string errorMessage = string.Empty;
    private bool isProcessing;
    private bool showValidation;
    private bool _userResponded;
    private CancellationTokenSource _timeoutCts = new();
    private TimeSpan? postponeTime;
    private bool localMeetingConfirmed;
    private bool isLoadingJiraIssues;
    private string jiraIssuesLoadingError = string.Empty;
    private readonly List<JiraIssue> jiraIssues = [];
    private string? selectedJiraIssueKey;

    private bool CanConfirm =>
        !isProcessing &&
        !localMeetingConfirmed &&
        endTime.HasValue &&
        !string.IsNullOrWhiteSpace(customDescription) &&
        !string.IsNullOrWhiteSpace(selectedJiraIssueKey) &&
        !isLoadingJiraIssues &&
        string.IsNullOrWhiteSpace(jiraIssuesLoadingError);

    protected override void OnInitialized()
    {
        if (Guid.TryParse(MeetingGuidString, out meetingGuid))
        {
            var uri = new Uri(navigationManager.Uri);
            var queryParams = System.Web.HttpUtility.ParseQueryString(uri.Query);
            
            meetingTitle = queryParams["title"];
            
            // Parse start time from event payload (passed as ticks)
            if (long.TryParse(queryParams["startTime"], out var startTimeTicks))
            {
                startTime = new DateTime(startTimeTicks);
            }
            else
            {
                // Fallback only if parameter missing
                startTime = DateTime.Now;
            }
            
            // Always default end time to current time
            endTime = DateTime.Now.TimeOfDay;
            // Default start time to original meeting start
            customStartTime = startTime.TimeOfDay;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadJiraIssuesAsync();
    }

    private void SubtractMinutes(int minutes)
    {
        if (!endTime.HasValue) return;
        
        // Work directly with TimeSpan for simpler logic
        var newEndTime = endTime.Value.Subtract(TimeSpan.FromMinutes(minutes));
        
        // Handle negative values (wrap to previous day scenario)
        if (newEndTime < TimeSpan.Zero)
        {
            newEndTime = TimeSpan.Zero;
        }
        
        // Ensure end time doesn't go before start time (same day comparison)
        if (startTime != DateTime.MinValue)
        {
            var startTimeSpan = startTime.TimeOfDay;
            if (newEndTime < startTimeSpan)
            {
                newEndTime = startTimeSpan;
            }
        }
        
        endTime = newEndTime;
        StateHasChanged();
    }

    private void ResetToCurrentTime()
    {
        endTime = DateTime.Now.TimeOfDay;
        StateHasChanged();
    }

    private void OnStartTimeChanged(TimeSpan? newTime)
    {
        customStartTime = newTime;
        StateHasChanged();
    }

    private void SubtractStartMinutes(int minutes)
    {
        if (!customStartTime.HasValue) return;
        var newStart = customStartTime.Value.Subtract(TimeSpan.FromMinutes(minutes));
        customStartTime = newStart < TimeSpan.Zero ? TimeSpan.Zero : newStart;
        StateHasChanged();
    }

    private void AddStartMinutes(int minutes)
    {
        if (!customStartTime.HasValue) return;
        var newStart = customStartTime.Value.Add(TimeSpan.FromMinutes(minutes));
        // Cap at end time so start never exceeds end
        if (endTime.HasValue && newStart > endTime.Value)
            newStart = endTime.Value;
        customStartTime = newStart;
        StateHasChanged();
    }

    private void ResetStartToOriginal()
    {
        customStartTime = startTime != DateTime.MinValue ? startTime.TimeOfDay : null;
        StateHasChanged();
    }

    private void OnTimeChanged(TimeSpan? newTime)
    {
        endTime = newTime;
        if (showValidation)
        {
            errorMessage = string.Empty;
        }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(meetingTitle))
        {
            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(TimeSpan.FromMinutes(10), _timeoutCts.Token);
                    
                    await InvokeAsync(async () =>
                    {
                        if (!_userResponded)
                        {
                            await StillOngoing();
                        }
                    });
                }
                catch (TaskCanceledException)
                {
                    // User responded before timeout
                }
            });
        }
    }

    private async Task LoadJiraIssuesAsync()
    {
        isLoadingJiraIssues = true;
        jiraIssuesLoadingError = string.Empty;

        try
        {
            var settings = jiraSettingsService.GetSettings();
            var hasFilterName = !string.IsNullOrWhiteSpace(settings.IssueFilterName);
            var hasRawJql = !string.IsNullOrWhiteSpace(settings.IssueRawJql);

            if (!hasFilterName && !hasRawJql)
            {
                throw new InvalidOperationException("Jira issue query source is not configured. Configure Filter Name or Raw JQL in Settings.");
            }

            if (hasFilterName && hasRawJql)
            {
                throw new InvalidOperationException("Jira issue query source is ambiguous. Configure exactly one: Filter Name or Raw JQL.");
            }

            var loadedIssues = hasFilterName
                ? await jiraRestApiClient.GetIssuesByFilterName(settings.IssueFilterName!)
                : await jiraRestApiClient.GetIssuesByRawJql(settings.IssueRawJql!);

            jiraIssues.Clear();
            jiraIssues.AddRange(loadedIssues);
            selectedJiraIssueKey = jiraIssues.FirstOrDefault()?.Key;
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Failed to load Jira issues for meeting confirmation popup");
            jiraIssuesLoadingError = $"Failed to load Jira issues. {GetErrorDetails(ex)}";
        }
        finally
        {
            isLoadingJiraIssues = false;
        }
    }

    private async Task ConfirmEnd()
    {
        if (string.IsNullOrEmpty(meetingTitle) || isProcessing || localMeetingConfirmed)
            return;

        showValidation = true;

        if (!endTime.HasValue || string.IsNullOrWhiteSpace(customDescription) || string.IsNullOrWhiteSpace(selectedJiraIssueKey))
        {
            errorMessage = "Meeting end time, Jira issue, and comment are required.";
            StateHasChanged();
            return;
        }

        _userResponded = true;
        _timeoutCts.Cancel();
        isProcessing = true;
        errorMessage = string.Empty;

        try
        {
            var (customEndTime, customStartDateTime) = GetEffectiveMeetingTimes();

            // Try to confirm pending meeting first, if that fails try manual end
            try
            {
                await meetingService.ConfirmMeetingEndAsync(meetingGuid, customDescription, customEndTime, customStartDateTime);
            }
            catch (InvalidOperationException)
            {
                // Meeting is not in pending state, try manual end
                await meetingService.EndMeetingManuallyAsync(meetingGuid, customDescription, customEndTime, customStartDateTime);
            }

            localMeetingConfirmed = true;

            var effectiveStartTime = customStartDateTime ?? startTime;
            var effectiveEndTime = customEndTime ?? DateTime.Now;
            var timeSpentSeconds = (int)Math.Round((effectiveEndTime - effectiveStartTime).TotalSeconds);

            await jiraRestApiClient.CreateIssueWorklog(
                selectedJiraIssueKey!,
                effectiveStartTime,
                timeSpentSeconds,
                customDescription.Trim());

            await CloseWindow();
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
            isProcessing = false;
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
            isProcessing = false;
        }
        catch (JiraApiException ex)
        {
            logger.LogError(ex, "Jira worklog logging failed for meeting {MeetingGuid}", meetingGuid);
            errorMessage = $"Meeting was confirmed locally, but Jira logging failed. {GetErrorDetails(ex)}";
            isProcessing = false;
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Unexpected error during meeting confirm-and-log flow for {MeetingGuid}", meetingGuid);
            errorMessage = $"Unexpected error while confirming/logging meeting. {GetErrorDetails(ex)}";
            isProcessing = false;
        }
    }

    private (DateTime? customEndTime, DateTime? customStartDateTime) GetEffectiveMeetingTimes()
    {
        DateTime? customEndTime = null;
        if (endTime.HasValue)
        {
            customEndTime = startTime.Date.Add(endTime.Value);
            if (customEndTime < startTime)
            {
                customEndTime = customEndTime.Value.AddDays(1);
            }
        }

        DateTime? customStartDateTime = null;
        if (customStartTime.HasValue && startTime != DateTime.MinValue)
        {
            customStartDateTime = startTime.Date.Add(customStartTime.Value);
        }

        return (customEndTime, customStartDateTime);
    }

    private static string GetErrorDetails(Exception exception)
    {
        if (exception is JiraApiException jiraApiException)
        {
            return $"HTTP {(int)jiraApiException.StatusCode} {jiraApiException.ReasonPhrase}. " +
                   $"Request: {jiraApiException.RequestPath}. Response: {jiraApiException.ResponseBody}";
        }

        return exception.Message;
    }

    private async Task StillOngoing()
    {
        if (string.IsNullOrEmpty(meetingTitle))
            return;

        _userResponded = true;
        _timeoutCts.Cancel();

        // If custom postpone time is set, postpone to that time
        if (postponeTime.HasValue)
        {
            await PostponeUntilSelectedTime();
            return;
        }

        // Otherwise, just cancel and let default recognition continue
        meetingService.CancelPendingEnd(meetingGuid);
        await CloseWindow();
    }

    private async Task CloseWindow()
    {
        await mediator.Send(new CloseWindowCommand(ParentMauiWindowId));
    }

    private void OnPostponeTimeChanged(TimeSpan? newTime)
    {
        postponeTime = newTime;
        // Trigger re-render to update "Still Ongoing" button text
        StateHasChanged();
    }

    private async Task Postpone(int minutes)
    {
        if (string.IsNullOrEmpty(meetingTitle) || isProcessing)
            return;

        var postponeUntil = DateTime.Now.AddMinutes(minutes);
        await ExecutePostpone(postponeUntil);
    }

    private async Task PostponeUntilSelectedTime()
    {
        if (!postponeTime.HasValue || string.IsNullOrEmpty(meetingTitle) || isProcessing)
            return;

        var today = DateTime.Today;
        var selectedTime = today.Add(postponeTime.Value);
        
        // If selected time is in the past today, assume user means tomorrow
        if (selectedTime < DateTime.Now)
        {
            selectedTime = selectedTime.AddDays(1);
        }
        
        // Validate not more than 24 hours
        if (selectedTime > DateTime.Now.AddHours(24))
        {
            errorMessage = "Postpone time cannot exceed 24 hours from now";
            StateHasChanged();
            return;
        }

        await ExecutePostpone(selectedTime);
    }

    private async Task ExecutePostpone(DateTime postponeUntil)
    {
        _userResponded = true;
        _timeoutCts.Cancel();
        isProcessing = true;
        errorMessage = string.Empty;

        try
        {
            await meetingService.PostponeCheckAsync(meetingGuid, postponeUntil);
            await CloseWindow();
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
            isProcessing = false;
            StateHasChanged();
        }
        catch (Exception)
        {
            errorMessage = "An error occurred while postponing. Please try again.";
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task CancelMeeting()
    {
        if (string.IsNullOrEmpty(meetingTitle) || isProcessing)
            return;

        _userResponded = true;
        _timeoutCts.Cancel();
        isProcessing = true;
        errorMessage = string.Empty;

        try
        {
            meetingService.CancelRecognizedMeeting(meetingGuid);
            await CloseWindow();
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
            isProcessing = false;
            StateHasChanged();
        }
        catch (Exception)
        {
            errorMessage = "An error occurred while canceling the meeting. Please try again.";
            isProcessing = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _timeoutCts?.Cancel();
        _timeoutCts?.Dispose();
    }
}
